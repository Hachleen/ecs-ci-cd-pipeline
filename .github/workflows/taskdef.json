{
  "family": "ecs-repo-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::443496862989:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::443496862989:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "ecs-repo",
      "image": "443496862989.dkr.ecr.us-east-1.amazonaws.com/ecs-repo:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ]
    }
  ]
}
